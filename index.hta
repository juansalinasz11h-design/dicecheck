<html>
<head>
<meta charset="utf-8">
<title>Online Dice</title>
<HTA:APPLICATION
  ID="OnlineDice"
  APPLICATIONNAME="Online Dice"
  BORDER="none"
  CAPTION="no"
  INNERBORDER="no"
  SCROLL="no"
  SELECTION="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="no"
  CONTEXTMENU="no"
  WINDOWSTATE="maximize"
  NAVIGABLE="no"
/>
<style>
  html, body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #070b1c;
    color: #fff;
    font-family: "Segoe UI", Inter, system-ui, sans-serif;
    user-select: none;
  }
  canvas#sky {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .wrap {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card {
    width: 420px;
    background: rgba(16, 20, 38, 0.92);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 18px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.45);
    padding: 42px 36px 36px;
    text-align: center;
  }
  .mark {
    width: 46px;
    height: 46px;
    margin: 0 auto 18px;
    border-radius: 12px;
    background: #4f46e5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.5px;
  }
  h1 {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.4px;
  }
  .sub {
    margin: 8px 0 28px;
    color: #8b93a7;
    font-size: 13px;
    min-height: 18px;
  }
  .stage {
    height: 92px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .spinner {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 2.5px solid rgba(79, 70, 229, 0.25);
    border-top-color: #6d64f5;
    animation: spin 0.85s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .bar {
    width: 180px;
    height: 3px;
    margin-top: 16px;
    border-radius: 99px;
    background: rgba(255,255,255,0.06);
    overflow: hidden;
  }
  .bar > i {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #4f46e5, #7c74ff);
    border-radius: 99px;
    animation: fill 7s linear forwards;
  }
  @keyframes fill { to { width: 100%; } }
  .ok {
    width: 42px;
    height: 42px;
    margin: 0 auto 18px;
    border-radius: 50%;
    background: rgba(16, 140, 90, 0.18);
    border: 1.5px solid #1f9d62;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ok svg { display: block; }
  .result {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
  }
  .done {
    margin: 8px 0 0;
    color: #8b93a7;
    font-size: 13px;
  }
  .hidden { display: none; }
  .foot {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 22px;
    text-align: center;
    color: #6d758c;
    font-size: 12px;
    z-index: 2;
    letter-spacing: 0.2px;
  }
  .type {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 46px;
    text-align: center;
    color: #9aa3b8;
    font-size: 13px;
    font-family: Consolas, "Cascadia Mono", monospace;
    z-index: 2;
    min-height: 18px;
  }
  .caret {
    display: inline-block;
    width: 7px;
    height: 13px;
    background: #9aa3b8;
    margin-left: 2px;
    vertical-align: -1px;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
</style>
</head>
<body>
<canvas id="sky"></canvas>
<div class="wrap">
  <div class="card">
    <div class="mark">D</div>
    <h1>Online Dice</h1>
    <div class="sub" id="sub">Analyzing the current dice system</div>
    <div class="stage" id="loading">
      <div class="spinner"></div>
      <div class="bar"><i></i></div>
    </div>
    <div id="result" class="hidden">
      <div class="ok">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M4.5 10.5 L8.2 14.2 L15.5 6.2" stroke="#2fbf78" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <p class="result">No riggers found</p>
      <p class="done">The scan completed successfully.</p>
    </div>
  </div>
</div>
<div class="type" id="type"></div>
<div class="foot">Online Dice · System Scanner</div>
<script>
(function () {
  var c = document.getElementById("sky");
  var ctx = c.getContext("2d");
  var stars = [];
  function resize() {
    c.width = window.innerWidth;
    c.height = window.innerHeight;
  }
  function seed() {
    stars = [];
    var n = Math.floor((c.width * c.height) / 9000);
    for (var i = 0; i < n; i++) {
      stars.push({
        x: Math.random() * c.width,
        y: Math.random() * c.height,
        r: Math.random() * 1.4 + 0.2,
        a: Math.random() * 0.7 + 0.15
      });
    }
  }
  function draw() {
    var g = ctx.createLinearGradient(0, 0, c.width, c.height);
    g.addColorStop(0, "#1a1460");
    g.addColorStop(0.45, "#0c1230");
    g.addColorStop(1, "#06101f");
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, c.width, c.height);
    ctx.fillStyle = "#c9d4ff";
    for (var i = 0; i < stars.length; i++) {
      var s = stars[i];
      ctx.globalAlpha = s.a;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, 6.28);
      ctx.fill();
    }
    ctx.globalAlpha = 0.18;
    ctx.strokeStyle = "#8ea0ff";
    ctx.lineWidth = 1;
    for (var j = 0; j < 18; j++) {
      var a = stars[(j * 17) % stars.length];
      var b = stars[(j * 17 + 5) % stars.length];
      if (!a || !b) continue;
      if (Math.hypot(a.x - b.x, a.y - b.y) > 220) continue;
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
  }
  resize();
  seed();
  draw();
  window.onresize = function () { resize(); seed(); draw(); };

  setTimeout(function () {
    document.getElementById("loading").className = "hidden";
    document.getElementById("result").className = "";
    document.getElementById("sub").innerText = "Scan finished";
  }, 7000);

  var lines = [
    "(this website is grok)",
    "(opened through mshta)",
    "(online dice · system scanner)",
    "(scanning for 7 seconds)"
  ];
  var el = document.getElementById("type");
  var li = 0, ci = 0, hold = 0;
  function tick() {
    var line = lines[li];
    if (ci <= line.length) {
      el.innerHTML = line.slice(0, ci) + '<span class="caret"></span>';
      ci++;
      setTimeout(tick, ci === 1 ? 400 : 48);
      return;
    }
    hold++;
    if (hold < 28) {
      setTimeout(tick, 70);
      return;
    }
    hold = 0;
    ci = 0;
    li = (li + 1) % lines.length;
    setTimeout(tick, 180);
  }
  tick();
})();
</script>
</body>
</html>
